<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.ui.MainGraphController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <style>-fx-background-color: #1E1E1E;</style>

    <!-- Canvas Principal (Centro) -->
    <center>
        <Pane fx:id="canvasContainer" style="-fx-background-color: #1E1E1E;"/>
    </center>

    <!-- Panel Inferior -->
    <bottom>
        <VBox spacing="10" style="-fx-border-color: #404040; -fx-border-width: 1 0 0 0; -fx-background-color: #252526;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Título -->
            <Label text="Información del Grafo">
                <font>
                    <Font size="14" name="Arial Bold"/>
                </font>
                <style>-fx-text-fill: #FFFFFF;</style>
            </Label>

            <!-- Información -->
            <Label fx:id="infoLabel" wrapText="true">
                <font>
                    <Font size="12" name="Arial"/>
                </font>
                <style>-fx-text-fill: #CCCCCC;</style>
            </Label>

            <!-- Botones -->
            <HBox spacing="10">
                <Button text="Actualizar" style="-fx-padding: 8px 20px; -fx-font-size: 12px; -fx-background-color: #0E639C; -fx-text-fill: #FFFFFF;" onAction="#onRefresh"/>
                <Button text="Ver Detalles" style="-fx-padding: 8px 20px; -fx-font-size: 12px; -fx-background-color: #0E639C; -fx-text-fill: #FFFFFF;" onAction="#onShowDetails"/>
                <Button text="BFS" style="-fx-padding: 8px 20px; -fx-font-size: 12px; -fx-background-color: #16A34A; -fx-text-fill: #FFFFFF;" onAction="#onBFS"/>
                <Button text="DFS" style="-fx-padding: 8px 20px; -fx-font-size: 12px; -fx-background-color: #16A34A; -fx-text-fill: #FFFFFF;" onAction="#onDFS"/>
            </HBox>
        </VBox>
    </bottom>

    <!-- Panel Derecho (Añadido por FXMLLoader dinámicamente) -->
    <right>
        <VBox fx:id="rightPanel">
            
        </VBox>
    </right>

</BorderPane>
